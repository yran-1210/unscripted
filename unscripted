
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Unscripted</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:#050505;color:#eeeae2}
body{min-height:100svh;cursor:text}
#keyboard{position:fixed;width:1px;height:1px;opacity:0;pointer-events:none}
#space{min-height:100svh;padding:15vh 7vw 18vh;display:flex;align-items:center}
#composition{width:100%;display:flex;flex-wrap:wrap;align-items:baseline;align-content:center;font-size:clamp(42px,7.5vw,112px)}
.character{flex:0 0 auto;display:inline-flex;align-items:baseline;justify-content:center;height:1.65em}
.shape{display:inline-block;line-height:1;white-space:pre;transform-origin:50% 80%;user-select:none;animation:appear .18s ease-out both}
.word-space{width:.38em}
.line-break{flex-basis:100%;height:.2em}
#caret{display:inline-block;flex:0 0 2px;width:2px;height:.9em;margin:0 .1em;background:#eeeae2;align-self:baseline;animation:blink 1.1s steps(1) infinite}
body.unfocused #caret{opacity:.2;animation:none}
#hint{position:fixed;left:7vw;bottom:30px;color:#626262;font:10px Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase;pointer-events:none}
body.has-text #hint{opacity:0}
@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}
@keyframes appear{from{opacity:0}to{opacity:1}}
@media(prefers-reduced-motion:reduce){.shape,#caret{animation:none}}
</style>
</head>
<body>
<textarea id="keyboard" maxlength="1200" aria-label="Type here" spellcheck="false"></textarea>
<main id="space">
<div id="composition"><span id="caret"></span></div>
</main>
<p id="hint">Click anywhere. Type something.</p>
<script>
const keyboard=document.getElementById("keyboard");
const composition=document.getElementById("composition");
const caret=document.getElementById("caret");
const context=document.createElement("canvas").getContext("2d");

const symbolChance=.12;
const fonts=[
["Arial, sans-serif",400],
["Arial, sans-serif",900],
["Helvetica, Arial, sans-serif",300],
["Georgia, serif",400],
["Georgia, serif",700],
["Times New Roman, serif",400],
["Courier New, monospace",400],
["Courier New, monospace",700]
];
const symbols=["○","●","◇","△","□","+","×","/",":","*","~"];
const beats=[
[.85,1.04,.94],
[1,.8,1.22],
[.76,1.18,.84],
[1.16,.95,1.08]
];
const random=(a,b)=>a+Math.random()*(b-a);
const pick=a=>a[Math.floor(Math.random()*a.length)];
let characters=[],previousText=[];

function createCharacter(source,index){
const element=document.createElement("span");
if(source==="\n"){
element.className="line-break";
return{source,element};
}
if(/\s/u.test(source)){
element.className="character word-space";
return{source,element};
}
const beat=beats[index%4];
const font=pick(fonts);
const visible=/[\p{L}\p{N}]/u.test(source)&&Math.random()<symbolChance?pick(symbols):source;
const size=beat[0]*random(.88,1.13);
const sx=beat[1]*random(.83,1.16);
const sy=beat[2]*random(.86,1.16);
const italic=Math.random()<.2;
const shape=document.createElement("span");
element.className="character";
shape.className="shape";
shape.textContent=visible;
shape.style.fontFamily=font[0];
shape.style.fontWeight=font[1];
shape.style.fontStyle=italic?"italic":"normal";
shape.style.fontSize=size+"em";
shape.style.transform=`translateY(${random(-.06,.06)}em) scale(${sx},${sy})`;
element.appendChild(shape);
context.font=`${italic?"italic":"normal"} ${font[1]} 100px ${font[0]}`;
element.style.width=Math.max(.18,context.measureText(visible).width/100*size*sx+.07)+"em";
return{source,element};
}

function update(){
const next=Array.from(keyboard.value);
let prefix=0,suffix=0;
while(prefix<previousText.length&&prefix<next.length&&previousText[prefix]===next[prefix])prefix++;
while(suffix<previousText.length-prefix&&suffix<next.length-prefix&&previousText[previousText.length-1-suffix]===next[next.length-1-suffix])suffix++;
characters=[
...characters.slice(0,prefix),
...next.slice(prefix,next.length-suffix).map((c,i)=>createCharacter(c,prefix+i)),
...(suffix?characters.slice(-suffix):[])
];
previousText=next;
composition.replaceChildren(...characters.map(c=>c.element),caret);
document.body.classList.toggle("has-text",next.length>0);
requestAnimationFrame(()=>caret.scrollIntoView({block:"nearest",inline:"nearest"}));
}
function focusTyping(){
keyboard.focus({preventScroll:true});
const end=keyboard.value.length;
keyboard.setSelectionRange(end,end);
}
document.getElementById("space").addEventListener("click",focusTyping);
keyboard.addEventListener("input",e=>{if(!e.isComposing)update()});
keyboard.addEventListener("compositionend",update);
keyboard.addEventListener("focus",()=>document.body.classList.remove("unfocused"));
keyboard.addEventListener("blur",()=>document.body.classList.add("unfocused"));
keyboard.addEventListener("keydown",e=>{
if(!e.isComposing&&["ArrowLeft","ArrowRight","ArrowUp","ArrowDown","Home","End","PageUp","PageDown"].includes(e.key))e.preventDefault();
});
document.addEventListener("keydown",e=>{
if(document.activeElement===keyboard||e.metaKey||e.ctrlKey||e.altKey||e.key==="Tab")return;
if(e.key.length===1||e.key==="Enter"||e.key==="Backspace")focusTyping();
});
focusTyping();
</script>
</body>
</html>
